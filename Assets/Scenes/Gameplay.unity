  playerController: {fileID: 1533137522}
  animator: {fileID: 366777028}
  dialogueManager: {fileID: 631093950}
  dialogueLines:
  - speakerName: Girl
    text: Woy anjing!
  - speakerName: You
    text: Um... what did you say?
  - speakerName: Girl
    text: It means "Hello Handsome"
  - speakerName: You
    text: Oh... Hi, can i help you?
  - speakerName: Girl
    text: Does this place have any job openings? I could help here
  - speakerName: You
    text: Sorry miss, but we don't have any job available
  - speakerName: Girl
    text: And what are you doing here?
  - speakerName: You
    text: Working?
  - speakerName: Girl
    text: How come you can work but i can't?
  - speakerName: You
    text: Because..... all job position here are filled?
  - speakerName: Girl
    text: I get it, you want the money all to yourself, don't you realize that finding
      a job is hard?
  - speakerName: You
    text: Yes ma'am i get it but i'm not in control here, and...
  - speakerName: Girl
    text: Aight i get it, fuck you!

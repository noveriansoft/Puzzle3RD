MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1726678170}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1cf2492ae690bd64da2bd9c76a95b357, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  waypoints:
  - point: {fileID: 1533579594}
    waitHere: 0
    waitTime: 0
    rotateWhileWaiting: 0
    waitRotationY: 0
    startDialogue: 1
    aimWhileTalking: 0
  - point: {fileID: 1870899397}
    waitHere: 0
    waitTime: 0
    rotateWhileWaiting: 0
    waitRotationY: 0
    startDialogue: 0
    aimWhileTalking: 0
  moveSpeed: 1.2
  rotationSpeed: 7
  reachDistance: 0.1
  loop: 0
  disableOnFinish: 1
  playerController: {fileID: 1533137522}
  animator: {fileID: 1726678171}
  dialogueManager: {fileID: 631093950}
  dialogueLines:
  - speakerName: Man in Bear Suit
    text: Hey, sorry if i scared you before, you can call me......
  - speakerName: Man in Bear Suit
    text: Bear-man.
  - speakerName: You
    text: Uh.... okay?
  - speakerName: Man in Bear Suit
    text: I already in this bear suit for like 5 months now, I disguised myself as
      a bear to observe strange activity in this area. pretty sure you already heard
      about MGB, right?
  - speakerName: You
    text: Yes, one of my costumer told me about it before? Mega Galactic Beast, right?
      they are real?
  - speakerName: Man in Bear Suit
    text: They are real as fuck, you've seen body parts and a head inside a trash
      bin, right?
  - speakerName: You
    text: Yes, i try to contact the police, but....
  - speakerName: Man in Bear Suit
    text: Don't bother contacting them again, they're a bitch to the government now
  - speakerName: Man in Bear Suit
    text: Government try to hide this creature from public to prevent mass panic,
      but the thing is they try exploit them for their personal use
  - speakerName: Man in Bear Suit
    text: 'The government is trying to exploit them by placing people into these
      marts, when the time comes, the government will capture them and turn them
      into living weapons.



'
  - speakerName: You
    text: What the fuck? so they want me to die here? how do we put those MGB down?
  - speakerName: Man in Bear Suit
    text: It's hard, those MGB can disguise themself as human being, but my intel
      says they are shaped like tall black creatures, but sometimes they like to
      disguise themself as weird serial killer
  - speakerName: Man in Bear Suit
    text: I know this is sudden, but you have to defend yourself tonight, I just
      saw some strange creatures gathering in this forest, they might be planning
      to attack this mart.
  - speakerName: You
    text: What!? but i never-
  - speakerName: Man in Bear Suit
    text: "The government put you in military training before put you in this mart,
      right? Don't you find all that military training a bit strange for someone
      who\u2019s supposed to be a cashier at a EMPTY convenience store?"
  - speakerName: Man in Bear Suit
    text: We don't have much time, i have to go back to my headquarters before they
      attack it, goodluck for you
  player: {fileID: 1533137523}
  pressEUI: {fileID: 2075128311}
  interactionDistance: 2
  frontDetection: 0.6

  moveSpeed: 1.5
  rotationSpeed: 7
  reachDistance: 0.1
  loop: 0
  disableOnFinish: 1
  playerController: {fileID: 1533137522}
  animator: {fileID: 1714145832}
  dialogueManager: {fileID: 631093950}
  dialogueLines:
  - speakerName: Old Man
    text: Hey...
  - speakerName: You
    text: Can i help you, sir?
  - speakerName: Old Man
    text: I see you still haven't sell anything since yesterday
  - speakerName: You
    text: Yes sir, i'm sorry, there is a problem with the shipment
  - speakerName: Old Man
    text: Yeah whatever, the previous guy told me the same thing, this mart has gone
      through three employees, yet still doesn't sell anything.
  - speakerName: Old Man
    text: By the way, did you happen to know something called MGB?
  - speakerName: You
    text: MGB? what is that sir?
  - speakerName: Old Man
    text: Mega Galactic Beast, the name for aliens who can disguise themselves as
      humans and multiply themselves to take over the Earth
  - speakerName: Old Man
    text: "I heard there\u2019s a lot of MGB activity around here, that\u2019s why
      the government set up this store and put employees here, to lure those aliens
      out"
  - speakerName: You
    text: That's crazy, It probably just a conspiracy
  - speakerName: Old Man
    text: It might be, but if you don't believe me, try to contact local police if
      you see something sus, they might be don't give a shit about it because goverment
      already told them to stay away
  - speakerName: You
    text: Alright, I'll keep that in mind
  - speakerName: Old Man
    text: Aight, later.
  player: {fileID: 1533137523}
  pressEUI: {fileID: 2075128311}
  interactionDistance: 2
  frontDetection: 0.6

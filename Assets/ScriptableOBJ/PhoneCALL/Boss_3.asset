  m_Script: {fileID: 11500000, guid: 1dd57f5cc0414ed4080340baf95634fa, type: 3}
  m_Name: Boss_3
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: You
    text: Hello, sir. i've seen so many weird things here, like i even see strange
      black tall creature, i think this place is dangerous, sir, can I request a
      transfer to a different work location?
  - speakerName: Boss
    text: Black tall creature? what do you mean? you watch too many sci-fi movies
      young man, hahahaha! that place is safe, you don't need to be afraid
  - speakerName: You
    text: But sir! i've seen it myself!
  - speakerName: Boss
    text: No, you're just tired, now get back to work!
  advanceToNextDialogue: 1
